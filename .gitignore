# === Whitelist mode: ignore everything by default, then re-allow only known demo files ===
*

# Re-allow this gitignore itself
!.gitignore

# Re-allow project meta / handoff docs
!README.md
!DEPLOYMENT.md
!robots.txt

# Re-allow intranet deployment helpers
!deploy/
!deploy/**

# Re-allow demo HTML files (explicit list, not wildcard)
!index.html
!brand.html
!products.html
!academy.html
!challenge.html
!digital.html
!admin.html
!career.html
!onboarding.html
!login.html
!day3.html
!firebase-app.js
!firestore.rules
!firebase.json
!.firebaserc
!package.json
!package-lock.json

# Re-allow assets folder and contents
!assets/
!assets/**

# Re-allow backend folder
!backend/
!backend/**

# Re-allow knowledge base and model evaluation docs
!kb/
!kb/**
!model_eval/
!model_eval/**

# Explicitly never include
research_notes.md
content/
logo_base64.txt
.DS_Store
Thumbs.db
*.tmp
*.bak

# Backend secrets / venv (絕對不能進 repo)
backend/credentials/notebooklm_storage.json
backend/credentials/*.json
backend/.venv/
backend/__pycache__/
backend/.env
backend/data/products_private.json
backend/data/kb_chunks.json
backend/data/*.npz
!backend/data/.gitkeep

# Generated runtime files
backend/kb_full_system_prompt.txt
backend/cookie_lifetime_log*.csv
backend/test_stdout.log
